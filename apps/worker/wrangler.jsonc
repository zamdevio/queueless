{
	"name": "queueless",
	"main": "src/index.ts",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{
				"name": "QUEUE_DO",
				"class_name": "QueueDO"
			},
			{
				"name": "RATE_LIMIT_DO",
				"class_name": "RateLimitDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["QueueDO", "RateLimitDO"]
		}
	],
	"vars": {
		"ENVIRONMENT": "development",
		"ALLOWED_ORIGINS": "http://localhost:5173,https://thequeueless.pages.dev"
	}
}
