{
  "name": "@queueless/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 execute queueless --local --file=./drizzle/0000_init.sql",
    "db:migrate:local": "wrangler d1 migrate queueless --local",
    "db:migrate:remote": "wrangler d1 migrate queueless",
    "db:seed": "wrangler d1 execute queueless --local --file=./drizzle/seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
